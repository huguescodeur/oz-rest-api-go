# ── Base de données ───────────────────────────────────────────────────────────
# Utiliser DATABASE_URL (Supabase/prod) OU les variables séparées (local)

DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Variables séparées — dev local uniquement
DB_USER=oz
DB_PASS=oz_secret
DB_ADDR=localhost:5432
DB_NAME=oz_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_with_openssl_rand_base64_32

# ── Email ─────────────────────────────────────────────────────────────────────
# Priorité d'envoi : SMTP → Resend → Mailjet → dry-run (log console)
#
# LOCAL (dev) — Gmail SMTP, port 587, fonctionne sur Mac/PC
# Générer un App Password : Google → Sécurité → Mots de passe des applications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_email@gmail.com
SMTP_PASS=app_password_gmail

# PROD (Render & cloud) — port 587 SMTP bloqué
# Mailjet (API HTTP) : envoie à n'importe quel destinataire, 200 emails/jour gratuit
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Resend (API HTTP) : alternative à Mailjet, gratuit mais destinataires
# restreints sans domaine personnalisé (free tier = compte owner uniquement)
RESEND_API_KEY=

# Expéditeur affiché dans les emails
MAIL_FROM=ton_email@gmail.com

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL utilisée dans les liens des emails (ex : lien reset password)
FRONTEND_URL=https://oz-backoffice.vercel.app
