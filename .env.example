# PostgreSQL — utiliser DATABASE_URL (Supabase) OU les variables séparées
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Variables séparées (si pas de DATABASE_URL)
DB_USER=oz
DB_PASS=oz_secret
DB_ADDR=localhost:5432
DB_NAME=oz_db

# Auth
JWT_SECRET=change_me_with_openssl_rand_base64_32

# Email — Gmail SMTP (recommandé)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_email@gmail.com
SMTP_PASS=app_password_gmail

# Email — Mailjet (fallback si pas de SMTP)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Email expéditeur
MAIL_FROM=ton_email@gmail.com

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL=https://oz-backoffice.vercel.app
